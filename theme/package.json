{
  "private": true,
  "name": "@janbiasi/slidev-theme",
  "version": "0.0.0",
  "type": "module",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev example.md --open",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@slidev/types": "catalog:",
    "seedrandom": "catalog:",
    "prism-theme-vars": "^0.2.5",
    "codemirror-theme-vars": "^0.1.2"
  },
  "devDependencies": {
    "@slidev/cli": "catalog:"
  },
  "//": "Learn more: https://sli.dev/guide/write-theme.html",
  "slidev": {
    "colorSchema": "both",
    "defaults": {
      "fonts": {
        "serif": "Stack Sans Notch",
        "sans": "Stack Sans Text",
        "mono": "Geist Mono"
      }
    }
  }
}
