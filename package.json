  "scripts": {
    "preview": "slidev-workspace preview",
    "build": "slidev-workspace build",
    "prettier": "prettier -w \"./slides/**/*.{js,ts,md}\"",
    "generate-preview-cover": "pnpm -r --filter \"@janbiasi/talk-*\" exec slidev export --range 1 --format png --output public/cover",
