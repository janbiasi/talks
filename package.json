    "playwright-chromium": "1.62.0",
    "prettier": "catalog:",
    "prettier-plugin-slidev": "catalog:",
    "slidev-addon-fancy-arrow": "catalog:",
    "vue": "catalog:"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "*"
  }
